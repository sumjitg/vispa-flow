{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceType",
  "version": "0.1.0",
  "identifier": "com.voicetype.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoiceType",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/voicetype-python"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sumjitg/vispa-flow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5N0ZBREE0QjU2MkEyNDEKUldSQm9tSzFwSzEvYVFUQ2E3QzVoWFQ3blFuQlM5SElqK09VNFRqOHlZL2xKbkozSUZmcXJpa0sK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
